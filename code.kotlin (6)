@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ChatScreen(
    viewModel: ChatViewModel,
    aiProvider: AiProvider,
    webFetcher: WebContentFetcher
) {
    var inputText by remember { mutableStateOf("") }
    var showSettings by remember { mutableStateOf(false) }
    var showModelPicker by remember { mutableStateOf(false) }
    var showDrawer by remember { mutableStateOf(false) }
    val listState = rememberLazyListState()
    val scope = rememberCoroutineScope()
    
    // Model picker dialog
    if (showModelPicker) {
        ModelPickerDialog(
            currentModel = viewModel.selectedModel,
            onSelect = { model ->
                viewModel.setModel(model)
                showModelPicker = false
            },
            onDismiss = { showModelPicker = false }
        )
    }
    
    Scaffold(
        topBar = {
            TopAppBar(
                title = {
                    Column {
                        Text(
                            "AI Chat مطلق",
                            fontWeight = FontWeight.Bold,
                            fontSize = 18.sp
                        )
                        if (viewModel.lastProvider.isNotEmpty()) {
                            Text(
                                "🔄 ${viewModel.lastProvider}",
                                fontSize = 10.sp,
                                color = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.7f)
                            )
                        }
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = MaterialTheme.colorScheme.primaryContainer,
                    titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer
                ),
                actions = {
                    IconButton(onClick = { showModelPicker = true }) {
                        Icon(Icons.Default.ModelTraining, contentDescription = "النموذج")
                    }
                    IconButton(onClick = { viewModel.clearChat() }) {
                        Icon(Icons.Default.Delete, contentDescription = "مسح")
                    }
                    IconButton(onClick = { showSettings = !showSettings }) {
                        Icon(Icons.Default.Settings, contentDescription = "الإعدادات")
                    }
                }
            )
        },
        bottomBar = {
            Surface(
                shadowElevation = 8.dp,
                color = MaterialTheme.colorScheme.surface
            ) {
                Column {
                    // Status bar
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(horizontal = 12.dp, vertical = 2.dp),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Text(
                            "🌐 متصل | ${viewModel.selectedModel}",
                            fontSize = 10.sp,
                            color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)
                        )
                        Text(
                            "🔥 ${viewModel.temperature}",
                            fontSize = 10.sp,
                            color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)
                        )
                    }
                    
                    // Settings panel
                    AnimatedVisibility(visible = showSettings) {
                        SettingsPanel(
                            viewModel = viewModel,
                            onDismiss = { showSettings = false }
                        )
                    }
                    
                    // Input area
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(8.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        // Quick actions
                        IconButton(
                            onClick = { inputText = "/search " }
                        ) {
                            Icon(Icons.Default.Search, contentDescription = "بحث", modifier = Modifier.size(22.dp))
                        }
                        
                        OutlinedTextField(
                            value = inputText,
                            onValueChange = { inputText = it },
                            modifier = Modifier
                                .weight(1f)
                                .heightIn(min = 48.dp, max = 120.dp),
                            placeholder = { Text("اسأل أي شيء...") },
                            maxLines = 5,
                            keyboardOptions = KeyboardOptions(
                                imeAction = ImeAction.Send
                            ),
                            keyboardActions = KeyboardActions(
                                onSend = {
                                    if (inputText.isNotBlank()) {
                                        viewModel.sendMessage(inputText, aiProvider, webFetcher)
                                        inputText = ""
                                    }
                                }
                            ),
                            shape = RoundedCornerShape(24.dp)
                        )
                        
                        Spacer(modifier = Modifier.width(8.dp))
                        
                        FilledIconButton(
                            onClick = {
                                if (inputText.isNotBlank()) {
                                    viewModel.sendMessage(inputText, aiProvider, webFetcher)
                                    inputText = ""
                                }
                            },
                            enabled = inputText.isNotBlank() && !viewModel.isLoading,
                            modifier = Modifier.size(48.dp),
                            shape = RoundedCornerShape(24.dp)
                        ) {
                            if (viewModel.isLoading) {
                                CircularProgressIndicator(
                                    modifier = Modifier.size(20.dp),
                                    strokeWidth = 2.dp,
                                    color = Color.White
                                )
                            } else {
                                Icon(
                                    Icons.Default.Send,
                                    contentDescription = "إرسال",
                                    tint = Color.White
                                )
                            }
                        }
                    }
                }
            }
        }
    ) { padding ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(horizontal = 8.dp),
            state = listState
        ) {
            items(
                items = viewModel.messages,
                key = { it.id }
            ) { message ->
                MessageBubble(
                    message = message,
                    isSystem = message.isSystem
                )
            }
            
            // Loading indicator
            if (viewModel.isLoading) {
                item {
                    Box(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(8.dp),
                        contentAlignment = Alignment.Center
                    ) {
                        Row(
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.Center
                        ) {
                            CircularProgressIndicator(modifier = Modifier.size(16.dp), strokeWidth = 2.dp)
                            Spacer(modifier = Modifier.width(8.dp))
                            Text(
                                "جاري الاتصال بخادم AI...",
                                fontSize = 12.sp,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                }
            }
            
            // Auto scroll
            item {
                LaunchedEffect(viewModel.messages.size) {
                    if (viewModel.messages.isNotEmpty()) {
                        listState.animateScrollToItem(viewModel.messages.size)
                    }
                }
                Spacer(modifier = Modifier.height(8.dp))
            }
        }
    }
}

@Composable
fun MessageBubble(
    message: ChatMessage,
    isSystem: Boolean = false
) {
    val alignment = when {
        isSystem -> Alignment.Center
        message.isUser -> Alignment.End
        else -> Alignment.Start
    }
    
    val bubbleColor = when {
        isSystem -> MaterialTheme.colorScheme.tertiaryContainer
        message.isUser -> MaterialTheme.colorScheme.primary
        else -> MaterialTheme.colorScheme.surfaceVariant
    }
    
    val textColor = when {
        isSystem -> MaterialTheme.colorScheme.onTertiaryContainer
        message.isUser -> MaterialTheme.colorScheme.onPrimary
        else -> MaterialTheme.colorScheme.onSurfaceVariant
    }
    
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp),
        horizontalAlignment = alignment
    ) {
        Box(
            modifier = Modifier
                .widthIn(
                    max = if (isSystem) 380.dp else 320.dp
                )
                .clip(
                    RoundedCornerShape(
                        topStart = 16.dp,
                        topEnd = 16.dp,
                        bottomStart = if (message.isUser || isSystem) 16.dp else 4.dp,
                        bottomEnd = if (message.isUser || isSystem) 4.dp else 16.dp
                    )
                )
                .background(bubbleColor)
                .padding(12.dp)
        ) {
            Text(
                text = message.content,
                color = textColor,
                fontSize = if (isSystem) 14.sp else 15.sp,
                lineHeight = 22.sp,
                textDirection = TextDirection.Content
            )
        }
    }
}

@Composable
fun ModelPickerDialog(
    currentModel: String,
    onSelect: (String) -> Unit,
    onDismiss: () -> Unit
) {
    val models = com.yourdomain.uncensoredchat.network.AiProvider.AVAILABLE_MODELS
    
    AlertDialog(
        onDismissRequest = onDismiss,
        title = {
            Text("اختيار نموذج AI", fontWeight = FontWeight.Bold)
        },
        text = {
            LazyColumn {
                items(models) { model ->
                    val isSelected = model == currentModel
                    
                    Card(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(vertical = 2.dp),
                        colors = CardDefaults.cardColors(
                            containerColor = if (isSelected)
                                MaterialTheme.colorScheme.primaryContainer
                            else
                                MaterialTheme.colorScheme.surfaceVariant
                        ),
                        onClick = { onSelect(model) }
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(12.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.SpaceBetween
                        ) {
                            Text(
                                model,
                                fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal
                            )
                            if (isSelected) {
                                Icon(
                                    Icons.Default.CheckCircle,
                                    contentDescription = "مختار",
                                    tint = MaterialTheme.colorScheme.primary,
                                    modifier = Modifier.size(18.dp)
                                )
                            }
                        }
                    }
                }
            }
        },
        confirmButton = {
            TextButton(onClick = onDismiss) {
                Text("تم")
            }
        }
    )
}

@Composable
fun SettingsPanel(
    viewModel: ChatViewModel,
    onDismiss: () -> Unit
) {
    Surface(
        color = MaterialTheme.colorScheme.surfaceVariant,
        modifier = Modifier.fillMaxWidth()
    ) {
        Column(
            modifier = Modifier.padding(16.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    "👑 الإعدادات المتقدمة",
                    style = MaterialTheme.typography.titleSmall,
                    fontWeight = FontWeight.Bold
                )
                TextButton(onClick = onDismiss) {
                    Text("تم")
                }
            }
            
            Spacer(modifier = Modifier.height(8.dp))
            
            // Temperature
            Text("🔥 الحرارة: %.2f".format(viewModel.temperature), fontSize = 13.sp)
            Slider(
                value = viewModel.temperature,
                onValueChange = { viewModel.temperature = it },
                valueRange = 0.0f..2.0f,
                steps = 19
            )
            
            Spacer(modifier = Modifier.height(4.dp))
            
            // Max Tokens
            Text("📝 الحد الأقصى: ${viewModel.maxTokens}", fontSize = 13.sp)
            Slider(
                value = viewModel.maxTokens.toFloat(),
                onValueChange = { viewModel.maxTokens = it.toInt() },
                valueRange = 256f..8192f,
                steps = 30
            )
            
            Spacer(modifier = Modifier.height(4.dp))
            
            // Web search toggle
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text("🌐 البحث في الإنترنت", fontSize = 13.sp)
                Switch(
                    checked = viewModel.webSearchEnabled,
                    onCheckedChange = { viewModel.webSearchEnabled = it }
                )
            }
            
            Spacer(modifier = Modifier.height(8.dp))
            
            // System prompt preview
            Text("⚙️ النظام:", fontSize = 12.sp, fontWeight = FontWeight.Bold)
            Text(
                viewModel.systemPrompt.take(80) + "...",
                fontSize = 10.sp,
                color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)
            )
        }
    }
}
